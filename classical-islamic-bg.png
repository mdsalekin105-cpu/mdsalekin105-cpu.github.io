.hero-ornament {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background-image: url("classical-islamic-bg.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: .30;
  pointer-events: none;
  z-index: 0;
}

.hero-inner {
  position: relative;
  z-index: 2;
}
